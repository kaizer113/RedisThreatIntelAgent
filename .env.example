# Redis Threat Intelligence Agent
APP_NAME=redis-threat-intelligence-agent
PORT=8082
LOG_LEVEL=INFO

# Google ADK orchestration (no Agent Platform Sessions or Memory Bank)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_MODELS=gemini-3.1-flash-lite gemini-3.1-pro-preview

# Redis database. Use the public endpoint locally and the private endpoint on the VM.
REDIS_URL=
VM_REDIS_URL=
REDIS_KEY_PREFIX=threatintel

# RedisVL
EMBEDDING_MODEL=redis/langcache-embed-v3-small
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_TTL_SECONDS=86400
SEMANTIC_ROUTER_THRESHOLD=0.48
SEMANTIC_ROUTER_INDEX=threatintel-router-v1

# Redis Context Retriever
CTX_ADMIN_KEY=
CTX_MCP_URL=https://gcp-us-east4.context-surfaces.redis.io/mcp
CTX_SURFACE_ID=
MCP_AGENT_KEY=
CONTEXT_SURFACE_NAME="Redis Threat Intelligence"
CONTEXT_AGENT_NAME=redis-threat-intelligence-agent

# Redis LangCache: reserved for stable analyst guidance, never final verdicts
LANGCACHE_HOST=https://gcp-us-east4.langcache.redis.io
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
LANGCACHE_SIMILARITY_THRESHOLD=0.80

# Redis Agent Memory
AGENT_MEMORY_BASE_URL=https://gcp-us-east4.memory.redis.io
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_NAMESPACE=redis-threat-intelligence
AGENT_MEMORY_SIMILARITY_THRESHOLD=0.30

ANALYST_ID=security-analyst
AGENT_TIMEOUT_SECONDS=90

# Shared VM deployment target
THREAT_INTEL_DEPLOY_REGION=us-east4
THREAT_INTEL_VM_ZONE=us-east4-c
THREAT_INTEL_VM_NAME=valuewholesale-demo
THREAT_INTEL_OWNER_LABEL=lionel_giavelli
THREAT_INTEL_SKIP_DELETION_LABEL=yes
